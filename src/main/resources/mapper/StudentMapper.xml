<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.springbootdemo.mapper.StudentMapper">

    <select id="findAll"
            resultType="com.example.springbootdemo.entity.Student">

        SELECT
        id,
        student_no,
        name,
        age,
        gender
        FROM student

    </select>


    <select id="findById"
            parameterType="long"
            resultType="com.example.springbootdemo.entity.Student">

        SELECT
        id,
        student_no,
        name,
        age,
        gender
        FROM student
        WHERE id = #{id}

    </select>

</mapper>